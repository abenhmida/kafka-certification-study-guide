digraph ZeroCopy {
    rankdir=LR;

    KafkaLog [label="Kafka Log"];
    PageCache [label="OS Page Cache"];
    Sendfile [label="sendfile / zero-copy path"];
    Socket [label="Socket"];
    Consumer [label="Consumer"];

    KafkaLog -> PageCache;
    PageCache -> Sendfile;
    Sendfile -> Socket;
    Socket -> Consumer;
}