digraph NetworkPartition {
    rankdir=LR;

    subgraph cluster_left {
        label="Network Segment A";

        B1 [label="Broker 1"];
        B2 [label="Broker 2"];
    }

    subgraph cluster_right {
        label="Network Segment B";

        B3 [label="Broker 3"];
        B4 [label="Broker 4"];
    }

    Partition [label="NETWORK PARTITION"];

    B1 -> Partition;
    B2 -> Partition;
    Partition -> B3;
    Partition -> B4;
}