digraph KafkaLog {
    rankdir=LR;

    Partition [label="TopicA-Partition0"];

    Log [label="Log"];

    Segment0 [label="Segment 0\nbaseOffset=0"];
    Segment1 [label="Segment 1\nbaseOffset=1000"];
    Segment2 [label="Active Segment\nbaseOffset=2000"];

    Partition -> Log;

    Log -> Segment0;
    Log -> Segment1;
    Log -> Segment2;

    Segment2 -> Active [label="append"];
}